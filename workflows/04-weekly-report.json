      "id": "b27771dc-c3a6-53da-b6f7-99a7bdffdbb9",
      "name": "Load proposals",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const s = $('Load settings').first().json;\nconst P = $input.all().map(i => i.json).filter(p => p.proposal_id);\nconst by = (k) => P.reduce((m, p) => (m[p[k]] = (m[p[k]] || 0) + 1, m), {});\nconst st = by('status'), ca = by('cause');\nconst decided = (st.approved || 0) + (st.rejected || 0);\nconst L = [];\nL.push(`Zero-result searches found so far: ${P.length}`, '');\nL.push('By cause:'); Object.entries(ca).sort((a, b) => b[1] - a[1]).forEach(([k, v]) => L.push(`- ${k.replace(/_/g, ' ')}: ${v}`)); L.push('');\nL.push('By status:'); Object.entries(st).sort((a, b) => b[1] - a[1]).forEach(([k, v]) => L.push(`- ${k.replace(/_/g, ' ')}: ${v}`)); L.push('');\nif (decided) L.push(`Approval rate: ${Math.round((st.approved || 0) / decided * 100)}% of ${decided} decided fixes.`, '');\nconst demand = P.filter(p => p.cause === 'not_sold').map(p => p.query);\nif (demand.length) { L.push('Searches for things the shop may not sell:'); demand.forEach(q => L.push(`- ${q}`)); }\nreturn [{ json: { to: s.owner_email, subject: `Zero Results Fixer report: ${st.pending || 0} waiting, ${st.approved || 0} live`, text: L.join('\\n') } }];"
      },
      "id": "3d473e17-f808-52c4-ab9b-7127f16f631c",
