    {
      "name": "Read totals",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "include": "all",
        "assignments": {
          "assignments": [
            {
              "id": "t1",
              "name": "total",
              "value": "={{ $('Real rows').all().length }}",
              "type": "number"
            },
            {
              "id": "t2",
              "name": "approved",
              "value": "={{ $json.statuses.find(s => s.status === 'approved')?.count_proposal_id ?? 0 }}",
              "type": "number"
            },
            {
              "id": "t3",
              "name": "rejected",
              "value": "={{ $json.statuses.find(s => s.status === 'rejected')?.count_proposal_id ?? 0 }}",
              "type": "number"
            },
            {
              "id": "t4",
              "name": "pending",
              "value": "={{ $json.statuses.find(s => s.status === 'pending')?.count_proposal_id ?? 0 }}",
              "type": "number"
            },
            {
              "id": "t5",
              "name": "not_sold",
              "value": "={{ $json.causes.find(c => c.cause === 'not_sold')?.appended_query ?? [] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "b13c1884-6092-4a62-a49f-7e791cb2da2c"
    },
    {
      "name": "Build report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "to",
              "value": "={{ $('Load settings').first().json.owner_email }}",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "subject",
              "value": "=Zero Results Fixer report: {{ $json.pending }} waiting, {{ $json.approved }} live",
              "type": "string"
            },
            {
              "id": "b3",
              "name": "text",
              "value": "=Zero-result searches found so far: {{ $json.total }}\n\nBy cause:\n{{ $json.causes.map(c => `- ${String(c.cause).replaceAll('_', ' ')}: ${c.count_proposal_id}`).join('\\n') }}\n\nBy status:\n{{ $json.statuses.map(s => `- ${String(s.status).replaceAll('_', ' ')}: ${s.count_proposal_id}`).join('\\n') }}\n\n{{ $json.approved + $json.rejected > 0 ? `Approval rate: ${Math.round($json.approved / ($json.approved + $json.rejected) * 100)}% of ${$json.approved + $json.rejected} decided fixes.` : 'No fixes decided yet.' }}\n\n{{ $json.not_sold.length ? 'Searches for things the shop may not sell:\\n' + $json.not_sold.map(q => `- ${q}`).join('\\n') : '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "570b904b-f983-41e2-af6d-60e87f50cc15"
    },
    {
      "name": "Email the report",
      "type": "n8n-nodes-base.gmail",
