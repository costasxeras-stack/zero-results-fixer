        0
      ],
      "webhookId": "81502b6e-b16a-4e8d-8128-32be54ead342",
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.text }}",
        "options": {
          "appendAttribution": false,
          "senderName": "Zero Results Fixer"
        }
      },
      "id": "cfc47a4a-12f8-42b7-8735-5a4ae2af5e10"
    }
