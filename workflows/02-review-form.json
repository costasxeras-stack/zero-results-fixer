{
  "name": "Zero Results Fixer · 02 Review form",
  "nodes": [
    {
      "parameters": {
        "content": "## Zero Results Fixer · 02 Review\nThe owner opens this form from the link in the weekly email. Approving a fix adds a rule to `zrf_rules`, which the shop's search reads through workflow 03.\n\nThe link carries the proposal ID and a one-off token, so a guessed link cannot approve anything. A proposal can only be decided once.",
        "height": 240,
        "width": 420
      },
      "id": "52004d8a-bfb1-50e9-bc24-d19eeb8bb3a2",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -500,
        -240
      ]
    },
    {
      "parameters": {
        "formTitle": "Review a search fix",
        "formDescription": "Approve the rewrite from the weekly email, change it, or reject it. Approved fixes go live in the shop's search.",
        "formFields": {
          "values": [
            {
              "fieldName": "proposal_id",
              "fieldType": "hiddenField"
            },
            {
              "fieldName": "token",
              "fieldType": "hiddenField"
            },
            {
              "fieldName": "decision",
              "fieldLabel": "Your decision",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Approve the fix"
                  },
                  {
                    "option": "Approve with my own rewrite"
                  },
                  {
                    "option": "Reject"
                  }
                ]
              }
            },
            {
              "fieldName": "my_rewrite",
              "fieldLabel": "Your rewrite (only if you chose your own)",
              "placeholder": "for example: bunk bed"
            },
            {
              "fieldName": "note",
              "fieldLabel": "Note (optional)",
              "fieldType": "textarea"
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "path": "zrf-review",
          "appendAttribution": false,
          "buttonLabel": "Save decision"
        }
      },
      "id": "0ce5751a-5f9f-53a7-8540-db15f77c1288",
      "name": "Review form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        0,
        0
      ],
      "webhookId": "7a5d0f3e-0002-4c00-9000-0000000002f1"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "zrf_proposals"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "proposal_id",
              "condition": "eq",
              "keyValue": "={{ $json.proposal_id }}"
            }
          ]
        },
        "limit": 1
      },
      "id": "96e0ef62-e5e6-50fb-84a1-5c6d366718d5",
      "name": "Find proposal",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const f = $('Review form').first().json;\nconst p = $input.first().json;\nconst out = { proposal_id: f.proposal_id || '', ok: false, message: '' };\nif (!p.proposal_id || p.token !== f.token) { out.message = 'This link is not valid. Use the link from the latest weekly email.'; return [{ json: out }]; }\nif (p.status !== 'pending') { out.message = `This fix was already decided (${p.status}). Nothing changed.`; return [{ json: out }]; }\nconst d = f.decision || '';\nconst own = String(f.my_rewrite || '').trim().toLowerCase();\nif (d.startsWith('Approve with') && !own) { out.message = 'You chose your own rewrite but left it empty. Open the link again and type it.'; return [{ json: out }]; }\nout.ok = true;\nout.approved = d.startsWith('Approve');\nout.status = out.approved ? 'approved' : 'rejected';\nout.final_rewrite = out.approved ? (own && d.startsWith('Approve with') ? own : p.rewrite) : '';\nout.query = p.query; out.cause = p.cause;\nout.note = String(f.note || '').slice(0, 500);\nout.message = out.approved ? `Approved. Searches for \"${p.query}\" will now use \"${out.final_rewrite}\".` : `Rejected. \"${p.query}\" stays as it is.`;\nreturn [{ json: out }];"
      },
      "id": "f29b6377-4393-50c3-ac5f-753745e4eb5b",
      "name": "Check link and decision",
      "type": "n8n-nodes-base.code",
