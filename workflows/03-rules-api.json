{
  "name": "Zero Results Fixer · 03 Rules API",
  "nodes": [
    {
      "parameters": {
        "content": "## Zero Results Fixer · 03 Rules for the search\nThe shop's search calls this URL (GET) and gets every approved rewrite as JSON. It can cache the list and apply a rule when a shopper's search matches `from` exactly.\n\nOnly approved, active rules are returned.",
        "height": 220,
        "width": 400
      },
      "id": "de393b87-26f5-5291-805b-77122449f01b",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -460,
        -220
      ]
    },
    {
      "parameters": {
        "path": "zrf-rules",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "7550dd17-837f-5d30-9a98-671e1c883019",
      "name": "Search asks for rules",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "7a5d0f3e-0003-4c00-9000-0000000003a1"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "zrf_rules"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "active",
              "condition": "eq",
              "keyValue": "={{ true }}"
            }
          ]
        },
        "returnAll": true
      },
      "id": "324e6c9a-da76-55bd-a27b-59ac8e2ded22",
      "name": "Load active rules",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { count: $json.rules.filter(r => r.from).length, rules: $json.rules.filter(r => r.from) } }}",
        "options": {}
      },
      "id": "65add961-a492-58e8-ba8a-770912cabbfd",
      "name": "Send rules",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
