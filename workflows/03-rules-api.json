      "parameters": {
        "jsCode": "const rules = $input.all().map(i => i.json).filter(r => r.from_query)\n  .map(r => ({ from: r.from_query, to: r.to_query, cause: r.cause, approved_at: r.approved_at }));\nreturn [{ json: { count: rules.length, rules } }];"
      },
