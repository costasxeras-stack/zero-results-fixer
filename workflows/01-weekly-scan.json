      "parameters": {
        "text": "=Search with no results: \"{{ $json.query }}\"",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"cause\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"spelling\",\n        \"wording\",\n        \"brand_or_collection\",\n        \"too_specific\",\n        \"not_sold\",\n        \"not_a_product_search\"\n      ],\n      \"description\": \"Most likely reason the search found nothing\"\n    },\n    \"rewrite\": {\n      \"type\": \"string\",\n      \"description\": \"One rewritten search in lowercase, or empty string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"description\": \"0 to 1\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"description\": \"One short sentence for the person who approves the fix\"\n    }\n  },\n  \"required\": [\n    \"cause\",\n    \"rewrite\",\n    \"confidence\",\n    \"reason\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "You help an online shop fix searches that returned no products. The shop sells furniture and home goods. For the search below, decide the most likely cause and propose one rewritten search that the shop's keyword search would match. Keyword search only returns products that contain every word of the search, so a good rewrite is usually shorter and uses common product words.\n\nCauses:\n- spelling: a typo or misspelling (for example 'cloths' for 'clothes').\n- wording: the shopper used words the catalogue does not use, such as a synonym or extra words.\n- brand_or_collection: a brand, collection or model name or number the catalogue does not contain.\n- too_specific: too many details at once (size, colour, material and type together).\n- not_sold: the shop probably does not sell this kind of product. Leave rewrite empty.\n- not_a_product_search: not a product search at all (for example coupons or ideas). Leave rewrite empty.\n\nKeep the shopper's intent. Never rewrite to a different kind of product. Confidence is your probability (0 to 1) that the rewrite finds what the shopper wanted."
        }
      },
      "id": "73d66b0e-cbdf-58bb-8484-3db3c207f1a8",
      "name": "Claude: why no results?",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        0,
        380
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
