      },
      "id": "8efb0291-62bf-5b30-8964-b53cea9dfb27",
      "name": "Load settings",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "url": "={{ $json.query_source_url }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "e1f6c623-ace8-5bf4-a53e-033405e7d311",
      "name": "Get shopper searches",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// The demo source returns [{q, split, labels}]. Only the held-out test split is checked,\n// so results can be compared with Search Relevance Lab's scorecard.\nconst rows = $input.all().map(i => i.json);\nconst list = rows.length === 1 && Array.isArray(rows[0]) ? rows[0] : rows;\nreturn list\n  .filter(r => !r.split || r.split === 'test')\n  .map(r => ({ json: { query: String(r.q ?? r.query ?? '').trim() } }))\n  .filter(i => i.json.query);"
      },
      "id": "9f4620f4-d644-56c0-845e-8fbfb1c5505e",
      "name": "Keep test searches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Load settings').first().json.search_api_url }}/api/search?q={{ encodeURIComponent($json.query) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 200
            }
          },
          "response": {
            "response": {
              "neverError": false
            }
          },
          "timeout": 30000
        }
      },
      "id": "3410ea7e-a5a1-521f-97c5-0f0171b16e74",
      "name": "Run each search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nconst searches = $('Keep test searches').all();\n$input.all().forEach((item, i) => {\n  const kw = item.json.keyword || {};\n  if (kw.total === 0) out.push({ json: { query: searches[i].json.query } });\n});\nreturn out;"
      },
      "id": "4ecc7f15-4855-54ac-8198-7d0f387d6cf4",
      "name": "Keep zero-result searches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "zrf_proposals"
        },
        "matchType": "allConditions",
        "filters": {},
        "returnAll": true
      },
      "id": "2a4cc4d0-1d0e-5ea9-9609-c57c4d00648e",
      "name": "Load past proposals",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1300,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set($input.all().map(i => (i.json.query || '').toLowerCase()).filter(Boolean));\nconst max = Number($('Load settings').first().json.max_queries_per_run) || 30;\nconst fresh = $('Keep zero-result searches').all()\n  .map(i => i.json.query)\n  .filter((q, idx, arr) => !seen.has(q.toLowerCase()) && arr.indexOf(q) === idx)\n  .slice(0, max);\nreturn fresh.map(q => ({ json: { query: q } }));"
      },
      "id": "1246beaa-8c62-53fa-ae28-5f671e8c78e6",
      "name": "Skip searches seen before",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        0
      ]
    },
    {
      "parameters": {
        "text": "=Search with no results: \"{{ $json.query }}\"",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"cause\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"spelling\",\n        \"wording\",\n        \"brand_or_collection\",\n        \"too_specific\",\n        \"not_sold\",\n        \"not_a_product_search\"\n      ],\n      \"description\": \"Most likely reason the search found nothing\"\n    },\n    \"rewrite\": {\n      \"type\": \"string\",\n      \"description\": \"One rewritten search in lowercase, or empty string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"description\": \"0 to 1\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"description\": \"One short sentence for the person who approves the fix\"\n    }\n  },\n  \"required\": [\n    \"cause\",\n    \"rewrite\",\n    \"confidence\",\n    \"reason\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "You help an online shop fix searches that returned no products. The shop sells furniture and home goods. For the search below, decide the most likely cause and propose one rewritten search that the shop's keyword search would match. Keyword search only returns products that contain every word of the search, so a good rewrite is usually shorter and uses common product words.\n\nCauses:\n- spelling: a typo or misspelling (for example 'cloths' for 'clothes').\n- wording: the shopper used words the catalogue does not use, such as a synonym or extra words.\n- brand_or_collection: a brand, collection or model name or number the catalogue does not contain.\n- too_specific: too many details at once (size, colour, material and type together).\n- not_sold: the shop probably does not sell this kind of product. Leave rewrite empty.\n- not_a_product_search: not a product search at all (for example coupons or ideas). Leave rewrite empty.\n\nKeep the shopper's intent. Never rewrite to a different kind of product. Confidence is your probability (0 to 1) that the rewrite finds what the shopper wanted."
        }
      },
      "id": "73d66b0e-cbdf-58bb-8484-3db3c207f1a8",
      "name": "Claude: why no results?",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        0,
        380
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-haiku-5-5"
        },
        "options": {
          "temperature": 0,
          "maxTokensToSample": 512
        }
      },
      "id": "13773a25-9338-5f6b-817e-58c93c69d046",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        40,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const queries = $('Skip searches seen before').all();\nreturn $input.all().map((item, i) => {\n  const o = item.json.output || {};\n  const q = queries[i].json.query;\n  const rewrite = String(o.rewrite || '').trim().toLowerCase();\n  const ok = !item.json.error && o.cause;\n  return { json: {\n    proposal_id: 'zr_' + $now.toFormat('yyyyLLdd') + '_' + Math.random().toString(36).slice(2, 8),\n    token: Math.random().toString(36).slice(2, 12),\n    query: q,\n    found_at: $now.toISO(),\n    cause: ok ? o.cause : 'ai_failed',\n    rewrite: ok && rewrite !== q.toLowerCase() ? rewrite : '',\n    ai_confidence: ok ? Math.max(0, Math.min(1, Number(o.confidence) || 0)) : 0,\n    ai_reason: ok ? String(o.reason || '').slice(0, 300) : 'Claude could not be reached. Check this search by hand.',\n  } };\n});"
      },
      "id": "3de702b7-612d-5e5f-b5c9-e54d57cd4f94",
      "name": "Shape proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        380
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Load settings').first().json.search_api_url }}/api/search?q={{ encodeURIComponent($json.rewrite || $json.query) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 200
            }
          },
          "response": {
            "response": {
              "neverError": false
            }
          },
          "timeout": 30000
        }
      },
      "id": "9131fe42-c560-5394-bce6-849f3c48a158",
      "name": "Test the rewrite",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        380
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const props = $('Shape proposal').all();\nreturn $input.all().map((item, i) => {\n  const p = { ...props[i].json };\n  const kw = item.json.keyword || {};\n  p.results_after = p.rewrite ? (kw.total ?? 0) : 0;\n  p.top_results = p.rewrite ? (kw.results || []).slice(0, 3).map(r => r.name).join(' | ').slice(0, 600) : '';\n  if (p.cause === 'ai_failed') p.status = 'needs_review';\n  else if (p.cause === 'not_sold' || p.cause === 'not_a_product_search' || !p.rewrite) p.status = 'no_fix';\n  else if (p.results_after === 0) p.status = 'fix_failed_test';\n  else p.status = 'pending';\n  return { json: p };\n});"
      },
