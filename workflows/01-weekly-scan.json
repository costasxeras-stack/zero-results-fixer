            {
              "id": "sp5",
              "name": "cause",
              "value": "={{ $json.ai_ok ? $json.cause : 'ai_failed' }}",
              "type": "string"
            },
            {
              "id": "sp6",
              "name": "rewrite",
              "value": "={{ $json.ai_ok && $json.rewrite !== $json.query.toLowerCase() ? $json.rewrite : '' }}",
              "type": "string"
            },
            {
              "id": "sp7",
              "name": "ai_confidence",
              "value": "={{ $json.ai_ok ? Math.max(0, Math.min(1, $json.confidence)) : 0 }}",
              "type": "number"
            },
            {
              "id": "sp8",
              "name": "ai_reason",
              "value": "={{ $json.ai_ok ? $json.reason.slice(0, 300) : 'Claude returned an error or an answer in the wrong format. Check this search by hand.' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
