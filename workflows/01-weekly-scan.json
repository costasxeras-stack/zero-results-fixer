      "id": "7aa039f2-9c8e-5604-8d58-c45e55ef6b01",
      "name": "Save proposals",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1080,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $('Load settings').first().json;\nconst all = $('Decide status').all().map(i => i.json);\nconst pending = all.filter(p => p.status === 'pending').sort((a, b) => b.ai_confidence - a.ai_confidence);\nconst failed = all.filter(p => p.status === 'fix_failed_test');\nconst nofix = all.filter(p => p.status === 'no_fix');\nconst review = all.filter(p => p.status === 'needs_review');\nconst link = p => `${s.review_form_url}?proposal_id=${encodeURIComponent(p.proposal_id)}&token=${p.token}`;\nconst L = [];\nL.push(`This week ${all.length} new searches returned no products.`);\nL.push(`${pending.length} have a tested fix waiting for you. Nothing changes until you approve.`, '');\npending.forEach((p, n) => {\n  L.push(`${n + 1}. \"${p.query}\"`);\n  L.push(`   Cause: ${p.cause.replace(/_/g, ' ')}. Claude's confidence ${p.ai_confidence.toFixed(2)}.`);\n  L.push(`   Fix: search \"${p.rewrite}\" instead. It now finds ${p.results_after} products, for example: ${p.top_results.split(' | ')[0] || ''}`);\n  L.push(`   Why: ${p.ai_reason}`);\n  L.push(`   Approve or reject: ${link(p)}`, '');\n});\nif (failed.length) { L.push(`Fixes that still found nothing (${failed.length}), not sent for approval:`); failed.forEach(p => L.push(`- \"${p.query}\" tried \"${p.rewrite}\"`)); L.push(''); }\nif (nofix.length) { L.push(`Probably not sold or not a product search (${nofix.length}). Worth a look as demand signals:`); nofix.forEach(p => L.push(`- \"${p.query}\" (${p.cause.replace(/_/g, ' ')})`)); L.push(''); }\nif (review.length) { L.push(`Claude could not read these (${review.length}). Check by hand:`); review.forEach(p => L.push(`- \"${p.query}\"`)); }\nreturn [{ json: { to: s.owner_email, subject: `Zero results this week: ${pending.length} fixes to approve`, text: L.join('\\n'), count: all.length } }];"
      },
